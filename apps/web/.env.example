# Copie para .env e preencha com os valores do seu projeto Supabase
# (local: rode `npx supabase start` na raiz e use os valores que aparecerem
# no terminal; cloud: Project Settings > API no painel do Supabase).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Chave PÚBLICA do par VAPID, usada para inscrever o aparelho nas notificações
# de lembrete. Opcional: sem ela, o botão "Avisos no celular" simplesmente não
# aparece. Gere o par com:
#   deno eval 'import w from "npm:web-push@^3.6.7"; console.log(w.generateVAPIDKeys())'
# A chave privada NÃO vai aqui — ela é segredo da Edge Function
# (ver supabase/functions/enviar-lembretes/index.ts).
VITE_VAPID_PUBLIC_KEY=
